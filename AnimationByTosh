--------------------------------------------------
-- PLAY ANIMATION FUNCTION
--------------------------------------------------

local function stopAllAnimations()

	for _, data in ipairs(animations) do

		if data.track then
			data.track:Stop(0.15)
		end

		data.playing = false

		if data.button then
			data.button.BackgroundColor3 = COLORS.Button
		end
	end
end


local function playAnimation(index)

	local data = animations[index]

	if not data then
		return
	end

	--------------------------------------------------
	-- IF ALREADY PLAYING -> STOP
	--------------------------------------------------

	if data.playing then

		if data.track then
			data.track:Stop(0.15)
		end

		data.playing = false

		if data.button then
			data.button.BackgroundColor3 = COLORS.Button
		end

		return
	end

	--------------------------------------------------
	-- STOP OTHER ANIMATIONS
	--------------------------------------------------

	for i, otherData in ipairs(animations) do

		if i ~= index and otherData.playing then

			if otherData.track then
				otherData.track:Stop(0.15)
			end

			otherData.playing = false

			if otherData.button then
				otherData.button.BackgroundColor3 = COLORS.Button
			end
		end
	end

	--------------------------------------------------
	-- REFRESH CHARACTER
	--------------------------------------------------

	if not character or not character.Parent then

		character = player.Character or player.CharacterAdded:Wait()
		humanoid = character:WaitForChild("Humanoid")
		animator = humanoid:WaitForChild("Animator")
	end

	--------------------------------------------------
	-- CREATE TRACK
	--------------------------------------------------

	if not data.track then

		data.track = animator:LoadAnimation(data.animation)

		-- Make animations continue until stopped
		data.track.Looped = true
	end

	--------------------------------------------------
	-- PLAY
	--------------------------------------------------

	if data.track then

		data.track:Play(0.15)

		data.playing = true

		if data.button then
			data.button.BackgroundColor3 = COLORS.Playing
		end
	end
end

