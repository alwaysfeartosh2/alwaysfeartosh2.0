-- CREATE ANIMATION BUTTONS
--------------------------------------------------

for i, data in ipairs(animationData) do

	local button = Instance.new("TextButton")

	button.Name = data.name .. "Button"
	button.BackgroundColor3 = COLORS.Button
	button.BorderSizePixel = 0

	-- Shows keybind
	button.Text = data.name .. " [" .. i .. "]"

	button.TextColor3 = COLORS.White
	button.TextSize = 11
	button.Font = Enum.Font.GothamBold
	button.AutoButtonColor = false
	button.LayoutOrder = i

	button.Parent = AnimationsContainer

	animations[i].button = button

	button.MouseEnter:Connect(function()

		if not animations[i].playing then
			button.BackgroundColor3 = COLORS.Hover
		end
	end)

	button.MouseLeave:Connect(function()

		if not animations[i].playing then
			button.BackgroundColor3 = COLORS.Button
		end
	end)

	button.MouseButton1Click:Connect(function()
		playAnimation(i)
	end)
end

