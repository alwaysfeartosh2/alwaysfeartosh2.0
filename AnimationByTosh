	button.BorderSizePixel = 0

	button.Text = data.name .. " [" .. data.key.Name .. "]"

	button.TextColor3 = COLORS.White
	button.TextSize = 13
	button.Font = Enum.Font.GothamBold
	button.AutoButtonColor = false

	button.Parent = SpecialButtonsContainer

	button.MouseEnter:Connect(function()

		button.BackgroundColor3 = data.color:Lerp(
			Color3.new(1, 1, 1),
			0.12
		)
	end)

	button.MouseLeave:Connect(function()
		button.BackgroundColor3 = data.color
	end)

	button.MouseButton1Click:Connect(function()

		local event = ReplicatedStorage:FindFirstChild(data.event)

		if event and event:IsA("RemoteEvent") then

			event:FireServer()

			local oldColor = data.color

			button.BackgroundColor3 = COLORS.White

			task.delay(0.15, function()

				if button and button.Parent then
					button.BackgroundColor3 = oldColor
				end
			end)

		else
			warn("RemoteEvent '" .. data.event .. "' not found!")
		end
	end)
end

--------------------------------------------------
-- KEYBINDS
--------------------------------------------------

UserInputService.InputBegan:Connect(function(input, gameProcessed)

	-- Don't activate while typing in chat/textboxes
	if gameProcessed then
		return
	end

	--------------------------------------------------
	-- 1-8 ANIMATIONS
	--------------------------------------------------

	for i, data in ipairs(animationData) do

		if input.KeyCode == data.key then
			playAnimation(i)
			return
		end
	end

	--------------------------------------------------
	-- MINI
	--------------------------------------------------

	if input.KeyCode == Enum.KeyCode.M then

		local event = ReplicatedStorage:FindFirstChild("MiniEvent")

		if event and event:IsA("RemoteEvent") then
			event:FireServer()
		end

		return
	end

	--------------------------------------------------
	-- HUGE
	--------------------------------------------------

	if input.KeyCode == Enum.KeyCode.H then

		local event = ReplicatedStorage:FindFirstChild("HugeEvent")

		if event and event:IsA("RemoteEvent") then
			event:FireServer()
		end

		return
	end

	--------------------------------------------------
	-- WIDE
	--------------------------------------------------

	if input.KeyCode == Enum.KeyCode.W then

		local event = ReplicatedStorage:FindFirstChild("WideEvent")

		if event and event:IsA("RemoteEvent") then
			event:FireServer()
		end

		return
	end

	--------------------------------------------------
	-- TOGGLE GUI
	--------------------------------------------------

	if input.KeyCode == Enum.KeyCode.RightShift then

		MainFrame.Visible = not MainFrame.Visible

		return
	end
end)

